{
  "commandPermissions": {
    "mode": "explicit",
    "allowedCommands": [
      "pnpm install",
      "pnpm run dev",
      "pnpm run build",
      "pnpm run lint",
      "pnpm run test",
      "pnpm add",
      "pnpm remove",
      "python -m venv .venv",
      "source .venv/bin/activate",
      ".venv/bin/pip install",
      ".venv/bin/pip install -r requirements.txt",
      ".venv/bin/uvicorn",
      ".venv/bin/pytest",
      ".venv/bin/ruff",
      "git status",
      "git add",
      "git commit",
      "git push",
      "git pull",
      "git branch",
      "git checkout",
      "git log",
      "git diff",
      "ls",
      "cat",
      "mkdir",
      "rm",
      "mv",
      "cp",
      "echo",
      "pwd",
      "cd"
    ],
    "deniedCommands": [
      "rm -rf /",
      "sudo",
      "chmod 777",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(git reset --hard*)",
      "Bash(gh auth *)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(**/*secret*)",
      "Read(**/*secrets*)",
      "Write(./.env*)",
      "Write(./**/.env*)",
      "Write(**/*secret*)",
      "Write(**/*secrets*)",
      "Edit(./.env*)",
      "Edit(./**/.env*)",
      "Edit(**/*secret*)",
      "Edit(**/*secrets*)",
      "Bash(* > .env*)",
      "Bash(* >> .env*)",
      "Bash(*secret*)",
      "Bash(*secrets*)"
    ]
  },
  "autoApprove": {
    "read": true,
    "write": false,
    "execute": false
  }
}
